{
  "name": "youtube-transcript-summarizer",
  "version": "1.0.16",
  "description": "Chrome extension that summarizes YouTube videos from their transcripts using OpenRouter.",
  "scripts": {
    "dev": "webpack --mode=development --watch",
    "build": "webpack --mode=production",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "version": "node scripts/sync-manifest-version.js && git add public/manifest.json"
  },
  "keywords": [
    "chrome-extension",
    "youtube",
    "transcript",
    "summarizer",
    "openrouter"
  ],
  "author": "Dan Avramescu",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/chrome": "^0.1.1",
    "@types/node": "^24.1.0",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^13.0.0",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "webpack": "^5.100.2",
    "webpack-cli": "^6.0.1"
  }
}
