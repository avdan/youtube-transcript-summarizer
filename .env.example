# OpenRouter API key used for transcript summaries.
# The Chrome extension UI stores this in Chrome storage, so this file is a local reference template.
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here

# Default model shown by the extension settings.
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Summary length preference: short, medium, or long.
SUMMARY_LENGTH=medium
